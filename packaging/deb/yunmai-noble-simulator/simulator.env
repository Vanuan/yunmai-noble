# Extra environment for yunmai-noble-simulator.service.
#
# Variables set here override values from simulator.toml. Use plain
# KEY=value lines; do not add `export`.
#
# HISTORIAN_PORT=3100
# DATABASE_PATH=/var/lib/yunmai-noble-simulator/historian.sqlite
# SIMULATOR_WEIGHT_KG=72.4
# SIMULATOR_AUTO_START=false
# SIMULATOR_REPEAT=false
