# Extra environment for yunmai-noble.service.
#
# Variables set here override values from config.toml. Use plain
# KEY=value lines; do not add `export`.
#
# HISTORIAN_HOST=0.0.0.0
# HISTORIAN_PORT=3000
# DATABASE_PATH=/var/lib/yunmai-noble/historian.sqlite
# CORS_ORIGIN=*
# YUNMAI_WS_URLS=
#
# Restrict the bundled service to a subset of drivers:
# SUITE_SCALES=dbus
# SUITE_NODE_ID_PREFIX=scale
