{
  "name": "yunmai-noble",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "bun run --cwd packages/node start",
    "dev": "bun run --cwd packages/node dev",
    "simulate": "bun run --cwd packages/node simulate",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "trustedDependencies": [
    "@abandonware/bluetooth-hci-socket",
    "@abandonware/noble",
    "usb"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  }
}
