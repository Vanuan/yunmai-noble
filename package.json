{
  "name": "yunmai-noble",
  "version": "0.2.2",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "bun run --cwd packages/node start",
    "dev": "bun run --cwd packages/node dev",
    "simulate": "bun run --cwd packages/node simulate",
    "historian": "bun run packages/historian/src/main.ts",
    "suite": "bun run packages/suite/src/main.ts",
    "lab": "bun run packages/suite/src/main.ts --config lab.toml",
    "desktop": "cargo build -p yunmai-noble-simulator-ui && cargo run -p yunmai-noble-desktop",
    "simulator-ui": "cargo run -p yunmai-noble-simulator-ui",
    "test:rust": "cargo test -p yunmai-noble-desktop -p yunmai-noble-simulator-ui",
    "check:rust": "cargo check -p yunmai-noble-desktop -p yunmai-noble-simulator-ui",
    "ui": "bun run --cwd packages/ui dev",
    "build:ui": "bun run --cwd packages/ui build",
    "deb": "packaging/deb/build.sh",
    "test": "bun test packages",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui"
  },
  "trustedDependencies": [
    "@abandonware/bluetooth-hci-socket",
    "@abandonware/noble",
    "usb"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  }
}
